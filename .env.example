# Copiá este archivo a .env.local para desarrollo local. Nunca subas .env.local al repo.

# Clave de acceso a la app (opcional).
# - Si está definida, la app pide la clave una vez por dispositivo y la API rechaza
#   los pedidos que no la manden en el header `x-access-key` (responde UNAUTHORIZED).
# - Si está vacía o no existe, la app queda abierta (cómodo para desarrollo local).
# Usá una clave larga y aleatoria, por ejemplo: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
# En Vercel se carga en Settings → Environment Variables (Production y Preview).
ACCESS_KEY=

# Timeout en milisegundos para cada llamada a un proveedor (opcional, por defecto 10000).
PROVIDER_TIMEOUT_MS=10000
